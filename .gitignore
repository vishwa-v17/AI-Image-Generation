# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
env/
ENV/
.venv/

# Hugging Face and PyTorch model caches
.cache/
models/
*.bin
*.safetensors
*.ckpt
*.pt
*.pth

# Generated outputs (keep directory with .gitkeep)
generated_images/*
!generated_images/.gitkeep

# IDE and OS specific files
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log

# Exclude viva questions from GitHub repository
docs/viva_questions.md
